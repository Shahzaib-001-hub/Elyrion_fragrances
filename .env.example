# ============================================================================
# ELYRION Fragrances — Environment Variables Template
# ============================================================================

# Database Connection (MongoDB Atlas URI)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/elyrion_fragrances?retryWrites=true&w=majority"

# Application Base URL (e.g. http://localhost:3000 for local dev or https://elyrionfragrances.com for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brand & Store Configuration
NEXT_PUBLIC_SITE_NAME="ELYRION Fragrances Pakistan"
NEXT_PUBLIC_BRAND_TAGLINE="The Fragrance of Paradise"
NEXT_PUBLIC_CURRENCY="Rs."

# Customer Support WhatsApp Concierge (Without '+' sign e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="923000000000"

# Admin & Security
ADMIN_SECRET_KEY="your_secure_admin_secret_key"
NODE_ENV="development"

